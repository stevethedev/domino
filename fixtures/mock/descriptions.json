{
  "acme": {
    "CORE-1": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Rebuild checkout so partners can pay with tokenized cards, and so the order page survives a refresh."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Goals"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Accept partner payment tokens"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Persist tokenized cards on the order"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Ship behind the launch toggle"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Design doc: "
            },
            {
              "type": "text",
              "text": "Checkout v2 RFC",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://example.com/rfcs/checkout-v2"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "CORE-7": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Public API clients can currently send unlimited requests. Add a "
            },
            {
              "type": "text",
              "text": "token bucket",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " limiter per API key, owned by "
            },
            {
              "type": "mention",
              "attrs": {
                "id": "acc-priya-raman",
                "text": "@Priya Raman"
              }
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "100 requests per minute per key by default"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Limits configurable per partner"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Exceeding the limit returns 429 with Retry-After"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": {
            "language": "yaml"
          },
          "content": [
            {
              "type": "text",
              "text": "rateLimit:\n  default: 100/min\n  burst: 20"
            }
          ]
        },
        {
          "type": "panel",
          "attrs": {
            "panelType": "warning"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Don't enable for internal service accounts until "
                },
                {
                  "type": "text",
                  "text": "OPS-3",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " lands."
                }
              ]
            }
          ]
        },
        {
          "type": "taskList",
          "attrs": {
            "localId": "t1"
          },
          "content": [
            {
              "type": "taskItem",
              "attrs": {
                "localId": "a",
                "state": "DONE"
              },
              "content": [
                {
                  "type": "text",
                  "text": "Pick the storage backend"
                }
              ]
            },
            {
              "type": "taskItem",
              "attrs": {
                "localId": "b",
                "state": "TODO"
              },
              "content": [
                {
                  "type": "text",
                  "text": "Load test at 2× peak"
                }
              ]
            }
          ]
        },
        {
          "type": "mediaSingle",
          "attrs": {
            "layout": "center"
          },
          "content": [
            {
              "type": "media",
              "attrs": {
                "id": "m1",
                "type": "file",
                "collection": "jira"
              }
            }
          ]
        }
      ]
    },
    "CORE-8": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Clients need to see their remaining budget so they can slow down before hitting a "
            },
            {
              "type": "text",
              "text": "429",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "table",
          "content": [
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableHeader",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Header"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableHeader",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Meaning"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "X-RateLimit-Limit",
                          "marks": [
                            {
                              "type": "code"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableCell",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Requests allowed per window"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "X-RateLimit-Remaining",
                          "marks": [
                            {
                              "type": "code"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableCell",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Requests left in this window"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "X-RateLimit-Reset",
                          "marks": [
                            {
                              "type": "code"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableCell",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "When the window resets (epoch seconds)"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 2
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "All three are sent on every response, including 429s."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Mobile SDKs read these headers starting in "
            },
            {
              "type": "status",
              "attrs": {
                "text": "SDK 4.2",
                "color": "blue"
              }
            },
            {
              "type": "text",
              "text": " and back off on their own."
            }
          ]
        },
        {
          "type": "blockquote",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Partners asked for this in the Q3 review; see "
                },
                {
                  "type": "inlineCard",
                  "attrs": {
                    "url": "https://example.com/notes/q3-partner-review"
                  }
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Rollout is planned for "
            },
            {
              "type": "date",
              "attrs": {
                "timestamp": "1793836800000"
              }
            },
            {
              "type": "text",
              "text": ". "
            },
            {
              "type": "emoji",
              "attrs": {
                "shortName": ":rocket:",
                "text": "🚀"
              }
            }
          ]
        },
        {
          "type": "rule"
        },
        {
          "type": "heading",
          "attrs": {
            "level": 4
          },
          "content": [
            {
              "type": "text",
              "text": "Notes"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The middleware sits after authentication, so unauthenticated requests are limited by IP instead. That path already exists in the gateway and only needs the headers added; the per-key path is new and shares the counter store with "
            },
            {
              "type": "text",
              "text": "CORE-7",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Keep the header names stable: several partner SDKs pin them, and renaming would silently disable their back-off."
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Internal-only links like "
            },
            {
              "type": "text",
              "text": "this one",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "javascript:alert(1)"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " are shown as plain text."
            }
          ]
        }
      ]
    },
    "CORE-14": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Steps to reproduce:"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Add an item priced $10.005"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Open the cart"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Total shows $10.00 instead of $10.01"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Expected: half-cents round up ("
            },
            {
              "type": "text",
              "text": "banker's rounding",
              "marks": [
                {
                  "type": "em"
                }
              ]
            },
            {
              "type": "text",
              "text": " is wrong here)."
            }
          ]
        }
      ]
    },
    "WEB-3": {
      "type": "doc",
      "version": 1,
      "content": []
    }
  },
  "partner": {
    "PAY-3": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Exchange a card for a short-lived token. Acme calls this from checkout; contact "
            },
            {
              "type": "mention",
              "attrs": {
                "id": "acc-noor-haddad",
                "text": "@Noor Haddad"
              }
            },
            {
              "type": "text",
              "text": " for sandbox keys."
            }
          ]
        },
        {
          "type": "expand",
          "attrs": {
            "title": "Request example"
          },
          "content": [
            {
              "type": "codeBlock",
              "attrs": {
                "language": "http"
              },
              "content": [
                {
                  "type": "text",
                  "text": "POST /v1/tokens\nAuthorization: Bearer <key>"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
