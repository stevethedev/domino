{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Domino",
  "version": "0.3.0",
  "identifier": "org.change.domino",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Domino",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MjU5OUE0NTFEMTg0NEMKUldSTWhORlJwSmtsWjU2WTdWQi9wK3hlV2dObmF5bk9zd0NvVXB0QmxjL3lEMERVQ2p5Tk9qSVAK",
      "endpoints": ["https://github.com/stevethedev/domino/releases/latest/download/latest.json"]
    }
  }
}
