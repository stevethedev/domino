{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC, opening https issue links in the system browser, desktop notifications, and saving exports to a file the user picks",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
